# Copy this file to .env and fill in your own values.
# .env is already gitignored — never commit real secrets.

# ---- Required: LLM (Groq) --------------------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=GROQ_API_KEY

# ---- Required for Ingestion: Firecrawl --------------------------------------
# Get an API key at https://www.firecrawl.dev
FIRECRAWL_API_KEY=fc-c6c8ba03e4ce423cbb6bda5eaadcfa3b

# ---- Required for Live Web Search Fallback: SerpAPI ------------------------
# Get a free key at https://serpapi.com (100 free searches/month)
SERPAPI_API_KEY=your_serpapi_key_here

# ---- Optional: Redis Semantic Cache -----------------------------------------
# If Redis is not running or these are left unset, the app automatically
# falls back to the plain RAG + LLM pipeline (no caching, no errors).

# Connection string for your Redis / Redis Stack instance.
REDIS_URL=redis://localhost:6379

# Master on/off switch for the semantic cache. Set to "false" to bypass the
# cache entirely (e.g. while debugging retrieval/generation changes).
SEMANTIC_CACHE_ENABLED=true

# Cosine distance cutoff for a cache "hit". LOWER = stricter (fewer, more
# exact hits). HIGHER = looser (more hits, higher risk of a wrong match).
#   0.0        -> only near-identical questions match
#   0.10-0.20  -> good default range for paraphrased/similar questions
#   0.4+       -> starts matching loosely-related questions, use with care
SEMANTIC_CACHE_THRESHOLD=0.15

# How long (in seconds) a cached answer stays valid before it expires and
# the next matching question falls through to a fresh LLM call again.
# 86400 = 24 hours.
SEMANTIC_CACHE_TTL_SECONDS=86400

# Name of the Redis index/collection used for the cache. Change this if you
# want to run multiple independent caches against the same Redis instance.
SEMANTIC_CACHE_NAME=au_it_rag_cache
